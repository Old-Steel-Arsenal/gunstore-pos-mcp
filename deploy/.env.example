# Copy to deploy/.env on the POS host. No secrets belong here.
# The store's public POS URL, no trailing slash: the OAuth issuer, the Host the
# local POS is addressed by, and the base of the connector URLs.
FRAPPE_BASE_URL=https://pos.oldsteelarsenal.com
# The POS frontend on this host (compose.noproxy publishes it on loopback 8080).
FRAPPE_INTERNAL_URL=http://127.0.0.1:8080
# The image build to run — a tested one: sha-<7> from the image workflow, or a version.
MCP_TAG=sha-0000000
