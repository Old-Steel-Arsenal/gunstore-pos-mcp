# Copy to deploy/.env on the POS host. No secrets belong here.
# The store's public POS URL (also the OAuth issuer the connector names).
POS_PUBLIC_URL=https://pos.oldsteelarsenal.com
FRAPPE_BASE_URL=https://pos.oldsteelarsenal.com
# The POS frontend on this host (compose.noproxy publishes it on loopback 8080).
FRAPPE_INTERNAL_URL=http://127.0.0.1:8080
# Optional: pin an image (sha-<7> or a version) instead of :main.
# MCP_TAG=sha-abc1234
